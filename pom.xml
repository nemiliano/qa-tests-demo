<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.nemiliano.qa.demo</groupId>
  <artifactId>qa-tests-demo</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>QA Tests Demo</name>
  <description>Proyecto de práctica que consume qa-framework-core.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <qa.framework.version>0.1.0-SNAPSHOT</qa.framework.version>
    <datafaker.version>2.7.0</datafaker.version>
    <surefire.version>3.6.0</surefire.version>
    <spotless.version>3.10.3</spotless.version>
    <allure.maven.version>2.18.0</allure.maven.version>
    <allure.cli.version>2.46.1</allure.cli.version>

    <!-- Filtros por tag. Ejemplos:
         mvnw test -Dgroups=smoke
         mvnw test -Dgroups="api & ui"
         mvnw test -DexcludedGroups=none -Dgroups=demo-failure   (el test que falla a propósito) -->
    <groups></groups>
    <excludedGroups>demo-failure</excludedGroups>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Una sola línea fija las versiones de todo el framework y sus librerías -->
      <dependency>
        <groupId>com.nemiliano.qa</groupId>
        <artifactId>qa-framework-bom</artifactId>
        <version>${qa.framework.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Framework: se declara solo lo que se usa -->
    <dependency>
      <groupId>com.nemiliano.qa</groupId>
      <artifactId>qa-junit-extensions</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.nemiliano.qa</groupId>
      <artifactId>qa-ui-selenium</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.nemiliano.qa</groupId>
      <artifactId>qa-ui-playwright</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.nemiliano.qa</groupId>
      <artifactId>qa-data</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.nemiliano.qa</groupId>
      <artifactId>qa-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.nemiliano.qa</groupId>
      <artifactId>qa-db</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Base H2 en memoria que usa la app local de práctica -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Datos generados -->
    <dependency>
      <groupId>net.datafaker</groupId>
      <artifactId>datafaker</artifactId>
      <version>${datafaker.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- JUnit, AssertJ y suites -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <groups>${groups}</groups>
          <excludedGroups>${excludedGroups}</excludedGroups>
          <systemPropertyVariables>
            <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <!-- Copia categorías de fallos e info de ambiente (con filtrado) a allure-results -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>allure-metadata</id>
            <phase>process-test-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/allure-results</outputDirectory>
              <resources>
                <resource>
                  <directory>src/test/allure</directory>
                  <filtering>true</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Reporte: mvnw allure:serve (abre el navegador) o mvnw allure:report -->
      <plugin>
        <groupId>io.qameta.allure</groupId>
        <artifactId>allure-maven</artifactId>
        <version>${allure.maven.version}</version>
        <configuration>
          <reportVersion>${allure.cli.version}</reportVersion>
          <resultsDirectory>${project.build.directory}/allure-results</resultsDirectory>
        </configuration>
      </plugin>

      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat/>
            <removeUnusedImports/>
          </java>
        </configuration>
        <executions>
          <execution>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
